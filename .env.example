# Copy to .env and fill in. Never commit .env.
GMAIL_CLIENT_CONFIG=gmail_credentials.json
GMAIL_TOKEN_FILE=token.json

# Optional cloud fallback. If set, email text can be sent to Google when Ollama is down.
# Leave empty for local-only.
GEMINI_API_KEY=
PRIMARY_MODEL=gemini-2.0-flash
FALLBACK_MODEL=gemini-flash-latest

OLLAMA_BASE_URL=http://localhost:11434
# llama3.2:3b measured ~2x faster than llama3 with fewer harmful mistakes (see DECISIONS.md)
OLLAMA_MODEL=llama3

POLLING_INTERVAL_SECONDS=60
CONFIDENCE_THRESHOLD=70

# off | assist | autonomous. "assist" never changes your Gmail. Use "autonomous"
# only after reviewing the rules: it archives and labels real mail.
AUTOPILOT_MODE=assist
AUTOPILOT_AUTO_SEND_REPLIES=false

# Server binds to 127.0.0.1. Set to 0.0.0.0 only on a trusted network (no login).
# INBOXIQ_HOST=127.0.0.1
# CORS_ORIGINS=

# Erase stored email bodies after N days (subjects and decisions are kept). 0 = keep forever.
RETENTION_DAYS=30

# Show API docs at /docs (off by default).
# INBOXIQ_DEBUG=1
