# Public demo image: the dashboard on 80 synthetic emails.
# No Gmail, no model, no secrets. Suitable for Hugging Face Spaces (port 7860).
#   docker build -f Dockerfile.demo -t inboxiq-demo .
#   docker run --rm -p 7860:7860 inboxiq-demo

FROM node:22-slim AS ui
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ ./src/
COPY eval/data/synthetic_mailbox.jsonl ./eval/data/synthetic_mailbox.jsonl
COPY scripts/demo_server.py ./scripts/demo_server.py
COPY --from=ui /ui/dist ./frontend/dist

# INBOXIQ_PUBLIC_DEMO lets any visitor use the demo. Safe only because this image
# has synthetic mail and no Gmail access. Never set it for the real app.
# ALLOWED_HOSTS="*" accepts the hosting domain (e.g. *.hf.space).
ENV DEMO_HOST=0.0.0.0 DEMO_PORT=7860 PYTHONUNBUFFERED=1 \
    INBOXIQ_PUBLIC_DEMO=1 ALLOWED_HOSTS="*" CORS_ORIGINS="*"
EXPOSE 7860
# Runs as a non-root user (Hugging Face Spaces requires uid 1000).
RUN useradd -m -u 1000 demo
USER demo
CMD ["python", "scripts/demo_server.py"]
